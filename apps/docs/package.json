{
  "name": "@kyora/docs",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "start": "next start",
    "check-types": "fumadocs-mdx && next typegen && tsc --noEmit",
