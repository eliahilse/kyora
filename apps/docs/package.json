    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.17.1",
    "@takumi-rs/image-response": "^0.70.4",
    "fumadocs-core": "16.6.14",
    "fumadocs-mdx": "14.2.9",
    "fumadocs-ui": "16.6.14",
    "lucide-react": "^0.577.0",
    "next": "16.1.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.1",
    "@types/mdx": "^2.0.13",
    "@types/node": "^25.3.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "postcss": "^8.5.8",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.9.3",
    "eslint-config-next": "16.1.6",
    "eslint": "^10.0.3"
  }
